{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentforge-3-redteam.internal/contracts/v1/errors/regression_detected.schema.json",
  "title": "RegressionDetectedError",
  "description": "Regression Harness -> Orchestrator: a previously fixed exploit reappeared on a regression sweep, or an unrelated fix introduced a cross-category regression.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "error_type", "message", "exploit_id", "category", "previous_status", "detected_at"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "error_type": { "const": "regression_detected" },
    "message": { "type": "string", "minLength": 1 },
    "exploit_id": { "type": "string", "pattern": "^EXP-[0-9]{4,}$" },
    "category": {
      "enum": [
        "prompt_injection",
        "data_exfiltration",
        "state_corruption",
        "tool_misuse",
        "denial_of_service",
        "identity_authz"
      ]
    },
    "previous_status": { "enum": ["fixed", "mitigated"] },
    "detected_at": { "type": "string", "format": "date-time" }
  }
}
